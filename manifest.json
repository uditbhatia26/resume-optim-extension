{
    "manifest_version": 3,
    "name": "ResumeSculpt - AI Resume Optimizer",
    "version": "1.0.0",
    "description": "Optimize your resume for any job with AI-powered matching and tailoring",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "http://localhost:5173/*"
            ],
            "js": [
                "content/bridge.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "http://localhost:5173/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "ResumeSculpt",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
